{% set active_route = active_route|default(null) %}
{% set active_label = active_label|default(null) %}
{% set active_submenu = active_submenu|default(null) %}
{% set is_consultation_active =
    active_label|default(null) == 'Consultation'
    or active_route|default('') starts with 'app_consultation_'
    or active_submenu|default(null) is not null
%}

{% set primary_navigation = [
    { label: 'Accueil', route: 'app_rdv', icon: 'house', href: path('app_rdv') },
    { label: 'CallBack', icon: 'phone-call', href: '#', badge: '2' },
    { label: 'Fiche clients', route: 'app_clients', icon: 'contact-round', href: path('app_clients') }
] %}

{% set consultation_submenu = [
    {
        label: 'En Communication',
        href: path('app_consultation_en_communication'),
        route: 'app_consultation_en_communication'
    },
    {
        label: 'En attente de Rdv',
        href: '#',
        disabled: true
    },
    {
        label: 'Avec Rdv',
        href: '#',
        disabled: true
    },
    {
        label: 'En attente de Paiement',
        href: '#',
        disabled: true
    },
    {
        label: 'Forfait en cours',
        href: '#',
        disabled: true
    },
    {
        label: 'Détails de consultation',
        href: path('app_consultation_details'),
        route: 'app_consultation_details'
    }
] %}

{% set secondary_navigation = [
    { label: 'Statistiques', icon: 'chart-column', href: '#' },
    { label: 'Configuration', icon: 'settings', href: '#' },
    { label: 'Déconnexion', icon: 'log-out', href: path('app_login') }
] %}

<aside class="rdv-sidebar" aria-label="Navigation principale">
    <div class="rdv-sidebar__top">
        <div class="rdv-sidebar__brand">
            <img src="{{ asset('images/logo-pingo.png') }}" alt="Pin’Go CRM" class="rdv-sidebar__logo">
        </div>

        <button class="rdv-sidebar__toggle" type="button" data-sidebar-toggle aria-label="Réduire le menu" aria-expanded="true">
            <span class="rdv-sidebar__toggle-icon rdv-sidebar__toggle-icon--collapse">
                {% include 'components/ui/icon.html.twig' with { name: 'chevrons-left', size: 'lg' } only %}
            </span>
            <span class="rdv-sidebar__toggle-icon rdv-sidebar__toggle-icon--expand">
                {% include 'components/ui/icon.html.twig' with { name: 'chevrons-right', size: 'lg' } only %}
            </span>
        </button>
    </div>

    <nav class="rdv-nav" aria-label="Menu CRM">
        <ul class="rdv-nav__list">
            {% for item in primary_navigation %}
                {% set route_match = item.route|default(null) and active_route == item.route %}
                {% set label_match = active_label is not null and item.label == active_label %}
                {% set is_active = route_match or (active_route is empty and label_match) %}

                <li class="rdv-nav__item{% if is_active %} is-active{% endif %}">
                    <a class="rdv-nav__link{% if is_active %} is-active{% endif %}" href="{{ item.href }}" {% if is_active %}aria-current="page"{% endif %}>
                        <span class="rdv-nav__icon">
                            {% include 'components/ui/icon.html.twig' with { name: item.icon, size: 'lg' } only %}
                        </span>
                        <span class="rdv-nav__label">{{ item.label }}</span>
                        {% if item.badge|default(false) %}
                            <span class="rdv-nav__badge">{{ item.badge }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}

            <li class="rdv-nav__item{% if is_consultation_active %} is-active is-open{% endif %}" data-sidebar-submenu>
                <button
                    type="button"
                    class="rdv-nav__link rdv-nav__link--submenu {{ is_consultation_active ? 'is-active' : '' }}"
                    data-sidebar-submenu-toggle
                    aria-expanded="{{ is_consultation_active ? 'true' : 'false' }}"
                    aria-controls="rdv-submenu-consultation"
                >
                    <span class="rdv-nav__icon">
                        {% include 'components/ui/icon.html.twig' with { name: 'stethoscope', size: 'lg' } only %}
                    </span>
                    <span class="rdv-nav__label">Consultation</span>
                    <span class="rdv-nav__chevron">
                        {% include 'components/ui/icon.html.twig' with { name: 'chevron-down', size: 'sm' } only %}
                    </span>
                </button>

                <ul class="rdv-nav__submenu" id="rdv-submenu-consultation">
                    {% for submenu_item in consultation_submenu %}
                        {% set submenu_route_match = submenu_item.route|default(null) and active_route == submenu_item.route %}
                        {% set submenu_label_match = active_submenu is not null and submenu_item.label == active_submenu %}
                        {% set is_submenu_active = submenu_route_match or submenu_label_match %}

                        <li class="rdv-nav__submenu-item{% if is_submenu_active %} is-active{% endif %}">
                            <a
                                href="{{ submenu_item.href }}"
                                class="rdv-nav__submenu-link{% if submenu_item.disabled|default(false) %} is-disabled{% endif %}{% if is_submenu_active %} is-active{% endif %}"
                                {% if submenu_item.disabled|default(false) %}aria-disabled="true" data-disabled-link{% endif %}
                                {% if is_submenu_active %}aria-current="page"{% endif %}
                            >
                                <span>{{ submenu_item.label }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </li>

            {% for item in secondary_navigation %}
                {% set route_match = item.route|default(null) and active_route == item.route %}
                {% set label_match = active_label is not null and item.label == active_label %}
                {% set is_active = route_match or (active_route is empty and label_match) %}

                <li class="rdv-nav__item{% if is_active %} is-active{% endif %}">
                    <a class="rdv-nav__link{% if is_active %} is-active{% endif %}" href="{{ item.href }}" {% if is_active %}aria-current="page"{% endif %}>
                        <span class="rdv-nav__icon">
                            {% include 'components/ui/icon.html.twig' with { name: item.icon, size: 'lg' } only %}
                        </span>
                        <span class="rdv-nav__label">{{ item.label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    <div class="rdv-profile">
        <div class="rdv-profile__avatar" aria-hidden="true">A</div>
        <div class="rdv-profile__meta">
            <span>Connecté</span>
            <strong>alfred@pingo.fr</strong>
        </div>
    </div>
</aside>
