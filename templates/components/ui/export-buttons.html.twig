<div class="export-actions consultation-export-actions {{ extra_classes|default('') }}" aria-label="{{ aria_label|default('Actions dâ€™export') }}">
    <button class="export-btn export-btn--csv consultation-export-button consultation-export-button--csv" type="button" aria-label="{{ csv_label|default('Exporter en CSV') }}">
        {% include 'components/ui/icon.html.twig' with { name: csv_icon|default('file-text'), size: 'sm' } only %}
        <span>CSV</span>
    </button>
    <button class="export-btn export-btn--pdf consultation-export-button consultation-export-button--pdf" type="button" aria-label="{{ pdf_label|default('Exporter en PDF') }}">
        {% include 'components/ui/icon.html.twig' with { name: pdf_icon|default('file-text'), size: 'sm' } only %}
        <span>PDF</span>
    </button>
    <button class="btn btn-ghost-purple consultation-copy-button" type="button">
        {% include 'components/ui/icon.html.twig' with { name: copy_icon|default('copy'), size: 'sm' } only %}
        <span>{{ copy_label|default('Copier') }}</span>
    </button>
</div>
