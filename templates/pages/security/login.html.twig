{% extends 'base.html.twig' %}
{% set layout_type = 'auth' %}

{% block title %}Connexion | Pin’Go CRM{% endblock %}

{% block auth_content %}
<main class="page-login">
    <section class="login-card" aria-label="Connexion à Pin’Go CRM">
        <div class="login-card__depth" aria-hidden="true"></div>

        <aside class="login-brand" aria-label="Pin’Go CRM">
            <div class="login-brand__circle">
                <div class="login-brand__logo">
                    <img src="{{ asset('images/logo-pingo.png') }}" alt="Pin’Go CRM" class="logo">
                </div>
            </div>
        </aside>

        <section class="login-card__content">
            <form class="login-form" action="#" method="post">
                <h1 class="login-form__title">sur votre CRM, Pin’Go</h1>

                <label class="login-field" for="login_email">
                    <input
                        id="login_email"
                        class="login-field__input"
                        type="email"
                        name="email"
                        placeholder="Adresse Email"
                        autocomplete="email"
                    >
                    <span class="login-field__icon" aria-hidden="true">
                        <i data-lucide="user"></i>
                    </span>
                </label>

                <label class="login-field" for="login_password">
                    <input
                        id="login_password"
                        class="login-field__input"
                        type="password"
                        name="password"
                        placeholder="Mot de passe"
                        autocomplete="current-password"
                    >
                    <span class="login-field__icon" aria-hidden="true">
                        <i data-lucide="lock"></i>
                    </span>
                </label>

                <label class="login-remember" for="remember_me">
                    <input
                        id="remember_me"
                        class="login-remember__input"
                        type="checkbox"
                        name="remember_me"
                    >
                    <span>Se souvenir de moi</span>
                </label>

                <button class="btn btn-primary-gradient login-form__button" type="submit">Se connecter</button>

                <a class="login-form__forgot" href="#">Mot de passe oublier ?</a>

                <p class="login-form__policies">Terms of use. Privacy policy</p>
            </form>
        </section>
    </section>

    <p class="page-login__copyright">Tous les droits sont réservés © 2025</p>
</main>
{% endblock %}
