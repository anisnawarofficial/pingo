        tel: '00 00 00 00 00',
        voyant: 'Lorem',
        consultant: 'Lorem',
        filled: false
    },
    {
        id: '423',
        startedAt: '11/12 11:39:35',
        since: '02h54m',
        client: 'Lore Opsum',
        birthDate: '08/10/1993',
        tel: '00 00 00 00 00',
        voyant: 'Lorem',
        consultant: 'Lorem',
        filled: false
    }
] %}

{% block body %}
{% embed 'components/dashboard/layout.html.twig' with {
    page_classes: 'rdv-page consultation-list-page',
    main_classes: 'consultation-list-main',
    content_classes: 'dashboard-content--consultation-list',
    active_label: 'Consultation',
    active_submenu: 'En Communication'
} %}
    {% block content %}
        {% include 'components/ui/page-header.html.twig' with {
            icon: 'headphones',
            title: 'Gestion des Consultations',
            subtitle: 'Ajouter une consultation - Gérer un forfait',
            action_label: 'Ajouter une Consultation',
            action_icon: 'plus',
            extra_classes: 'consultation-list-header',
            left_classes: 'consultation-list-header__title-group',
            icon_classes: 'consultation-list-header__icon',
            action_classes: 'btn-outline-purple consultation-list-add-button'
        } only %}

        {% embed 'components/ui/panel.html.twig' with {
            extra_classes: 'consultation-list-panel',
            attrs: { 'aria-labelledby': 'consultation-list-title' },
            use_body: false
        } %}
            {% block content %}
            <div class="consultation-list-panel__top">
                <h2 id="consultation-list-title">Consultation En communication</h2>

                {% include 'components/ui/table-controls.html.twig' with {
                    extra_classes: 'consultation-list-controls',
                    limit_classes: 'rdv-show-count consultation-list-count',
                    select_wrapper_classes: 'consultation-list-select',
                    select_icon_classes: 'consultation-list-select__icon',
                    search_classes: 'rdv-search consultation-list-search',
                    per_page: 6,
                    per_page_options: [6, 10, 25],
                    show_select_arrows: true,
                    search_placeholder: 'Rechercher...',
                    search_aria_label: 'Rechercher une consultation'
                } only %}

                {% include 'components/ui/export-buttons.html.twig' only %}
            </div>

            <div class="consultation-communication-table crm-table crm-table-scroll" role="table" aria-label="Consultations en communication" style="--table-columns: 0.5fr 1.2fr 1fr 1.3fr 1.6fr 1.5fr 1fr 1.2fr 0.9fr;">
                <div class="consultation-communication-table__head crm-table__header" role="row">
                    <span class="crm-table__cell" role="columnheader">#</span>
                    <span class="crm-table__cell" role="columnheader">Commencer</span>
                    <span class="crm-table__cell" role="columnheader">Depuis</span>
                    <span class="crm-table__cell" role="columnheader">Client</span>
                    <span class="crm-table__cell" role="columnheader">Date de naissance</span>
                    <span class="crm-table__cell" role="columnheader">Tél</span>
                    <span class="crm-table__cell" role="columnheader">Voyant</span>
                    <span class="crm-table__cell" role="columnheader">Consultant</span>
                    <span class="crm-table__cell" role="columnheader">Info</span>
                </div>

                <div class="consultation-communication-table__body crm-table__body">
                    {% for row in consultation_rows %}
                        <article class="consultation-communication-table__row crm-table__row{% if row.featured|default(false) %} is-featured crm-table__row--active{% endif %}" role="row">
                            <span class="crm-table__cell" role="cell" data-label="#">{{ row.id }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Commencer">{{ row.startedAt }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Depuis">{{ row.since }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Client">{{ row.client }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Date de naissance">{{ row.birthDate }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Tél">{{ row.tel }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Voyant">{{ row.voyant }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Consultant">{{ row.consultant }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Info">
                                {% include 'components/ui/info-pill.html.twig' with {
                                    label: row.id,
                                    icon: 'user',
                                    active: row.filled,
                                    active_class: 'is-filled',
                                    extra_classes: 'consultation-info-pill'
                                } only %}
                            </span>
                        </article>
                    {% endfor %}
                </div>
            </div>

            {% include 'components/ui/pagination.html.twig' with {
                extra_classes: 'rdv-panel__footer consultation-list-footer'
            } only %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
