{% extends 'base.html.twig' %}

{% block title %}Détails de consultation | Pin’Go CRM{% endblock %}

{% set history_cards = [
    { label: 'Rendez-vous', icon: 'calendar-days' },
    { label: 'Consultation', icon: 'stethoscope' },
    { label: 'Forfait', icon: 'package' },
    { label: 'Paiement', icon: 'credit-card' }
] %}

{% set info_rows = [
    [
        { label: 'Client:', value: 'Lorem Opsum Dolor' },
        { label: 'Date de naissance:', value: '01/01/2000' },
        { label: 'Tél:', value: '00 00 00 00 00' }
    ],
    [
        { label: 'E-mail:', value: 'Lorem@email.com', link: true },
        { label: 'Voyant | consultant:', value: 'Lorem Opsum' },
        { label: 'Source:', value: 'lorem' }
    ],
    [
        { label: 'Tarif:', value: '000.00€' },
        { label: 'Carte Principale:', value: 'xx xx xx xx xx xx xx', wide: true }
    ]
] %}

{% set payment_rows = [
    { id: '220', numberLine1: 'xxxx xxxx xxxx', numberLine2: 'xxxx', crypto: '985', month: '9', year: '2026', status: 'accepté', active: false },
    { id: '220', numberLine1: 'xxxx xxxx xxxx', numberLine2: 'xxxx', crypto: '985', month: '9', year: '2026', status: 'accepté', active: true },
    { id: '220', numberLine1: 'xxxx xxxx xxxx', numberLine2: 'xxxx', crypto: '985', month: '9', year: '2026', status: 'accepté', active: false },
    { id: '220', numberLine1: 'xxxx xxxx xxxx', numberLine2: 'xxxx', crypto: '985', month: '9', year: '2026', status: 'accepté', active: false }
] %}

{% block body %}
{% embed 'components/dashboard/layout.html.twig' with {
    page_classes: 'rdv-page consultation-page',
    main_classes: 'consultation-main',
    content_classes: 'dashboard-content--consultation',
    active_label: 'Consultation'
} %}
    {% block content %}
        {% include 'components/ui/page-header.html.twig' with {
            icon: 'file-text',
            icon_size: 'lg',
            title: 'Détails de consultation',
            action_icon: 'info',
            action_icon_size: 'md',
            action_attrs: { 'aria-label': 'Informations' },
            extra_classes: 'consultation-titlebar page-header--inline',
            left_classes: 'consultation-titlebar__block',
            icon_classes: 'consultation-titlebar__icon',
            action_classes: 'btn-circle consultation-info-button'
        } only %}

        <section class="consultation-history" aria-label="Historique et mode de paiement">
            <div class="consultation-history__group">
                <span class="consultation-history__label">Historique des:</span>

                <div class="consultation-history__cards">
                    {% for card in history_cards %}
                        <button class="btn consultation-history-card" type="button" data-modal-open="historique-modal" aria-haspopup="dialog" aria-controls="historique-modal">
                            {% include 'components/ui/icon.html.twig' with { name: card.icon, size: 'md' } only %}
                            <span>{{ card.label }}</span>
                        </button>
                    {% endfor %}
                </div>
            </div>

            <div class="consultation-payment-mode">
                <span>Mode de paiement:</span>
                <button class="btn-icon consultation-eye-button" type="button" aria-label="Voir le mode de paiement" data-modal-open="payment-modal" aria-haspopup="dialog" aria-controls="payment-modal">
                    {% include 'components/ui/icon.html.twig' with { name: 'eye', size: 'md' } only %}
                </button>
            </div>
        </section>

        <section class="crm-panel consultation-panel consultation-info-card" aria-labelledby="consultation-card-title">
            <header class="consultation-card-header">
                <div class="consultation-card-header__title">
                    <span class="consultation-card-header__icon">
                        {% include 'components/ui/icon.html.twig' with { name: 'user', size: 'lg', variant: 'primary' } only %}
                    </span>
                    <h2 id="consultation-card-title">CONS ID: 9</h2>
                </div>

                <div class="consultation-card-actions">
                    <button class="btn btn-primary-gradient consultation-edit-button" type="button">
                        {% include 'components/ui/icon.html.twig' with { name: 'pencil', size: 'sm' } only %}
                        <span>Editer</span>
                    </button>
                    <button class="btn-circle consultation-delete-button" type="button" aria-label="Supprimer la consultation">
                        {% include 'components/ui/icon.html.twig' with { name: 'trash-2', size: 'sm' } only %}
                    </button>
                </div>
            </header>

            <div class="consultation-info-grid">
                {% for row in info_rows %}
                    <div class="consultation-info-grid__row">
                        {% for item in row %}
                            <div class="consultation-info-item{% if item.wide|default(false) %} consultation-info-item--wide{% endif %}">
                                <span class="consultation-info-item__label">{{ item.label }}</span>
                                {% if item.link|default(false) %}
                                    <a class="consultation-info-item__value consultation-info-item__value--link" href="mailto:{{ item.value }}">{{ item.value }}</a>
                                {% else %}
                                    <span class="consultation-info-item__value">{{ item.value }}</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </section>

        <div class="consultation-lower-grid">
            <section class="crm-panel consultation-panel consultation-rdv-panel" aria-labelledby="rdv-management-title">
                <header class="consultation-section-header">
                    <div class="consultation-section-header__title">
                        <span class="consultation-section-header__icon">
                            {% include 'components/ui/icon.html.twig' with { name: 'calendar-days', size: 'md', variant: 'primary' } only %}
                        </span>
                        <h2 id="rdv-management-title">GESTION DES RDV</h2>
                    </div>

                    <button class="btn btn-primary-gradient consultation-pill-button" type="button">
                        {% include 'components/ui/icon.html.twig' with { name: 'history', size: 'sm' } only %}
                        <span>Pré-auto</span>
                    </button>
                </header>

                <div class="consultation-rdv-table" role="table" aria-label="Gestion des rendez-vous">
                    <div class="consultation-rdv-table__head" role="row">
                        <span role="columnheader">Date</span>
                        <span role="columnheader">Historique</span>
                        <span role="columnheader">Status</span>
                        <span role="columnheader">Actions</span>
                    </div>

                    <article class="consultation-rdv-table__row" role="row">
                        <span role="cell" data-label="Date">
                            <span class="consultation-date-stack">
                                <span>2025-12-11</span>
                                <span>08:46:00</span>
                            </span>
                        </span>
                        <span role="cell" data-label="Historique">
                            <button class="btn-icon consultation-history-icon-button" type="button" aria-label="Voir l’historique" data-modal-open="historique-modal" aria-haspopup="dialog" aria-controls="historique-modal">
                                {% include 'components/ui/icon.html.twig' with { name: 'book-open', size: 'md' } only %}
                            </button>
                        </span>
                        <span role="cell" data-label="Status">
                            <span class="consultation-status">En cours</span>
                        </span>
                        <span role="cell" data-label="Actions">
                            <span class="consultation-rdv-actions">
                                <button class="btn-table-pill" type="button">Reporter</button>
                                <button class="btn-table-pill" type="button">En communication</button>
                                <button class="btn-table-pill" type="button">Annuler</button>
                            </span>
                        </span>
                    </article>
                </div>
            </section>

            <section class="crm-panel consultation-panel consultation-comments-panel" aria-labelledby="comments-title">
                <header class="consultation-section-header">
                    <div class="consultation-section-header__title">
                        <span class="consultation-section-header__icon">
                            {% include 'components/ui/icon.html.twig' with { name: 'file-text', size: 'md', variant: 'primary' } only %}
                        </span>
                        <h2 id="comments-title">COMMENTAIRES:</h2>
                    </div>

                    <button class="btn btn-outline-purple consultation-add-comment-button" type="button">
                        {% include 'components/ui/icon.html.twig' with { name: 'plus', size: 'sm' } only %}
                        <span>Ajouter</span>
                    </button>
                </header>

                <div class="consultation-comment-section">
                    <h3>Consultation</h3>
                    <div class="consultation-comment-table" role="table" aria-label="Commentaires consultation">
                        <div class="consultation-comment-table__head" role="row">
                            <span role="columnheader">Date:</span>
                            <span role="columnheader">Description:</span>
                            <span role="columnheader">Action:</span>
                        </div>
                        <div class="consultation-comment-table__row" role="row">
                            <span role="cell" data-label="Date:">
                                <span class="consultation-date-stack">
                                    <span>2025-12-11</span>
                                    <span>08:46:00</span>
                                </span>
                            </span>
                            <span role="cell" data-label="Description:">Lorem Opsum dolor oreum</span>
                            <span role="cell" data-label="Action:">Lorem Opsum</span>
                        </div>
                    </div>
                </div>

                <div class="consultation-comment-section">
                    <h3>Client</h3>
                    <div class="consultation-comment-empty" aria-label="Commentaires client"></div>
                </div>
            </section>
        </div>
    {% endblock %}
{% endembed %}

{% embed 'components/ui/modal.html.twig' with {
    id: 'historique-modal',
    size: 'medium',
    overlay_classes: 'historique-modal-overlay',
    modal_classes: 'historique-modal',
    close_classes: 'historique-modal__close',
    close_label: 'Fermer l’historique',
    badge_title: 'Lorem Opsum Dolor',
    badge_icon: 'file-text',
    badge_classes: 'historique-modal__header',
    footer: true,
    footer_classes: 'historique-modal__footer'
} %}
    {% block content %}

            <div class="historique-modal__table" role="table" aria-label="Détails de l’historique">
                <div class="historique-modal__table-head" role="row">
                    <span role="columnheader">Date:</span>
                    <span role="columnheader">Description:</span>
                    <span role="columnheader">Action:</span>
                </div>

                <div class="historique-modal__table-row" role="row">
                    <span role="cell" data-label="Date:">2025-12-11 08:46:00</span>
                    <span role="cell" data-label="Description:">
                        <span>Lorem Opsum dolor</span>
                        <span>oreum</span>
                    </span>
                    <span role="cell" data-label="Action:">Lorem Opsum</span>
                </div>
            </div>

    {% endblock %}

    {% block footer %}
        <button class="btn btn-primary-gradient historique-modal__button" type="button" data-modal-close>Fermer</button>
    {% endblock %}
{% endembed %}

{% embed 'components/ui/modal.html.twig' with {
    id: 'payment-modal',
    size: 'large',
    overlay_classes: 'payment-modal-overlay',
    modal_classes: 'payment-modal',
    close_classes: 'payment-modal__close',
    close_icon_size: 'xl',
    close_label: 'Fermer le mode de paiement',
    badge_title: 'Lorem Opsum Dolor',
    badge_icon: 'wallet-cards',
    badge_icon_size: 'xl',
    badge_classes: 'payment-modal__header'
} %}
    {% block content %}
            {% include 'components/ui/table-controls.html.twig' with {
                extra_classes: 'payment-modal__controls',
                limit_classes: 'payment-modal__count',
                select_wrapper_classes: 'payment-modal__select',
                select_icon_classes: 'payment-modal__select-icon',
                search_classes: 'payment-modal__search',
                per_page: 3,
                per_page_options: [3, 6, 12],
                show_select_arrows: true,
                search_placeholder: 'Rechercher...',
                search_aria_label: 'Rechercher un mode de paiement',
                select_aria_label: 'Nombre d’éléments de paiement affichés'
            } only %}

            <div class="payment-modal__table crm-table crm-table-scroll" role="table" aria-label="Modes de paiement" style="--table-columns: 0.7fr 1.7fr 1fr 1fr 1fr 1.3fr 0.9fr;">
                <div class="payment-modal__table-head crm-table__header" role="row">
                    {% for header in ['ID', 'Numéro', 'Crypto', 'Month', 'Year', 'Status', 'Maj'] %}
                        <span role="columnheader" class="crm-table__cell payment-modal__column-label">
                            <span>{{ header }}</span>
                            <span class="payment-modal__sort" aria-hidden="true">
                                {% include 'components/ui/icon.html.twig' with { name: 'chevron-up', size: 'xs' } only %}
                                {% include 'components/ui/icon.html.twig' with { name: 'chevron-down', size: 'xs' } only %}
                            </span>
                        </span>
                    {% endfor %}
                </div>

                <div class="payment-modal__table-body crm-table__body">
                    {% for row in payment_rows %}
                        <article class="payment-modal__table-row crm-table__row{% if row.active %} is-featured crm-table__row--active{% endif %}" role="row">
                            <span class="crm-table__cell" role="cell" data-label="ID">{{ row.id }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Numéro">
                                <span class="payment-modal__card-number">
                                    <span>{{ row.numberLine1 }}</span>
                                    <span>{{ row.numberLine2 }}</span>
                                </span>
                            </span>
                            <span class="crm-table__cell" role="cell" data-label="Crypto">{{ row.crypto }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Month">{{ row.month }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Year">{{ row.year }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Status">{{ row.status }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Maj">
                                <button class="btn-circle payment-modal__edit{% if row.active %} is-active{% endif %}" type="button" aria-label="Modifier la carte {{ row.id }}">
                                    {% include 'components/ui/icon.html.twig' with { name: 'pencil', size: 'md' } only %}
                                </button>
                            </span>
                        </article>
                    {% endfor %}
                </div>
            </div>

            {% include 'components/ui/pagination.html.twig' with {
                extra_classes: 'payment-modal__pagination',
                pages_classes: 'payment-modal__pages',
                show_all_classes: 'payment-modal__show-all',
                aria_label: 'Pagination des modes de paiement'
            } only %}

            <div class="payment-modal__actions">
                <button class="btn btn-primary-gradient payment-modal__add" type="button">
                    {% include 'components/ui/icon.html.twig' with { name: 'plus', size: 'md' } only %}
                    <span>Ajouter une autre carte</span>
                </button>
                <button class="btn btn-ghost-purple payment-modal__dismiss" type="button" data-modal-close>Fermer</button>
            </div>
    {% endblock %}
{% endembed %}
{% endblock %}
