{% block body %}
{% embed 'components/dashboard/layout.html.twig' with {
    page_classes: 'rdv-page',
    main_classes: 'rdv-main',
    content_classes: 'dashboard-content--rdv',
    active_label: 'Consultation'
} %}
    {% block content %}
        <section class="rdv-stats" aria-label="Indicateurs du jour">
            {% for card in stat_cards %}
                {% set card_tag = card.view|default(false) ? 'button' : 'article' %}
                <{{ card_tag }}
                    class="rdv-stat-card{% if card.view|default(null) == 'rdv' %} is-active{% endif %}"
                    {% if card.view|default(false) %}
                        type="button"
                        data-rdv-view-toggle="{{ card.view }}"
                        aria-pressed="{{ card.view == 'rdv' ? 'true' : 'false' }}"
                        aria-controls="rdv-panel-{{ card.view }}"
                    {% endif %}
                >
                    <span class="rdv-stat-card__top">
                        <span class="rdv-stat-card__icon">
                            {% include 'components/ui/icon.html.twig' with { name: card.icon, size: 'xl', variant: 'primary' } only %}
                        </span>
                        <span class="rdv-stat-card__meta {{ card.metaClass }}">{{ card.meta }}</span>
                    </span>
                    {% if card.submeta|default(false) %}
                        <span class="rdv-stat-card__submeta {{ card.submetaClass }}">{{ card.submeta }}</span>
                    {% endif %}
                    <strong class="rdv-stat-card__value">{{ card.value }}</strong>
                    <span class="rdv-stat-card__label">{{ card.label }}</span>
                </{{ card_tag }}>
            {% endfor %}
        </section>

        {% embed 'components/ui/panel.html.twig' with {
            extra_classes: 'rdv-panel',
            attrs: { 'data-rdv-panel': true },
            use_body: false
        } %}
            {% block content %}
            <div class="rdv-panel__views" aria-live="polite">
                <div class="rdv-panel__view is-active" id="rdv-panel-rdv" data-rdv-panel-view="rdv" aria-labelledby="rdv-list-title">
                    <header class="rdv-panel__header">
                <span class="rdv-panel__title-icon">
                    {% include 'components/ui/icon.html.twig' with { name: 'calendar-days', size: 'lg', variant: 'primary' } only %}
                </span>
                <h1 id="rdv-list-title">Liste des rendez-vous du jour</h1>
            </header>

            {% include 'components/ui/table-controls.html.twig' with {
                extra_classes: 'rdv-panel__controls',
                limit_classes: 'rdv-show-count',
                search_classes: 'rdv-search',
                per_page: 5,
                search_placeholder: 'Rechercher...',
                search_aria_label: 'Rechercher un rendez-vous'
            } only %}

            <div class="rdv-table crm-table crm-table-scroll" role="table" aria-label="Liste des rendez-vous" style="--table-columns: 1.25fr 1fr 1.05fr 0.72fr 1.78fr 1.05fr 0.8fr 0.68fr;">
                <div class="rdv-table__head crm-table__header" role="row">
                    <span class="crm-table__cell" role="columnheader">Client</span>
                    <span class="crm-table__cell" role="columnheader">Tel</span>
                    <span class="crm-table__cell" role="columnheader">Voyant</span>
                    <span class="crm-table__cell" role="columnheader">Heure</span>
                    <span class="crm-table__cell" role="columnheader">Historique</span>
                    <span class="crm-table__cell" role="columnheader">Consultant</span>
                    <span class="crm-table__cell" role="columnheader">Status</span>
                    <span class="crm-table__cell" role="columnheader">Détails</span>
                </div>

                <div class="rdv-table__body crm-table__body">
                    {% for row in appointment_rows %}
                        <article class="rdv-table__row crm-table__row" role="row">
                            <span class="crm-table__cell" role="cell" data-label="Client">{{ row.client }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Tel">{{ row.tel }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Voyant">{{ row.voyant }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Heure">{{ row.heure }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Historique">
                                <span class="rdv-history">
                                    {% for entry in row.history %}
                                        <span>{{ entry }}</span>
                                    {% endfor %}
                                </span>
                            </span>
                            <span class="crm-table__cell" role="cell" data-label="Consultant">{{ row.consultant }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Status">
                                <span class="rdv-status {{ row.statusClass }}">{{ row.status }}</span>
                            </span>
                            <span class="crm-table__cell" role="cell" data-label="Détails">
                                {% include 'components/ui/info-pill.html.twig' with {
                                    label: row.detail,
                                    icon: 'user',
                                    active: row.detailFilled,
                                    active_class: 'is-filled',
                                    extra_classes: 'rdv-detail-button'
                                } only %}
                            </span>
                        </article>
                    {% endfor %}
                </div>
            </div>

            {% include 'components/ui/pagination.html.twig' only %}
                </div>

                <div class="rdv-panel__view" id="rdv-panel-echeances" data-rdv-panel-view="echeances" aria-labelledby="echeances-list-title" aria-hidden="true" inert>
                    <header class="rdv-panel__header">
                        <span class="rdv-panel__title-icon">
                            {% include 'components/ui/icon.html.twig' with { name: 'wallet-cards', size: 'lg', variant: 'primary' } only %}
                        </span>
                        <h1 id="echeances-list-title">Liste des Echéances du jour</h1>
                    </header>

                    {% include 'components/ui/table-controls.html.twig' with {
                        extra_classes: 'rdv-panel__controls',
                        limit_classes: 'rdv-show-count',
                        search_classes: 'rdv-search',
                        per_page: 4,
                        per_page_options: [4, 10, 25],
                        search_placeholder: 'Rechercher...',
                        search_aria_label: 'Rechercher une échéance'
                    } only %}

                    <div class="rdv-table rdv-table--echeances crm-table crm-table-scroll" role="table" aria-label="Liste des Echéances" style="--table-columns: 1.35fr 1fr 1fr 1fr 0.72fr 0.58fr;">
                        <div class="rdv-table__head crm-table__header" role="row">
                            <span class="crm-table__cell" role="columnheader">Client</span>
                            <span class="crm-table__cell" role="columnheader">Tel</span>
                            <span class="crm-table__cell" role="columnheader">Voyant</span>
                            <span class="crm-table__cell" role="columnheader">Consultant</span>
                            <span class="crm-table__cell" role="columnheader">Status</span>
                            <span class="crm-table__cell" role="columnheader">Détails</span>
                        </div>

                        <div class="rdv-table__body crm-table__body">
                            {% for row in echeance_rows %}
                                <article class="rdv-table__row crm-table__row{% if row.featured|default(false) %} is-featured crm-table__row--active{% endif %}" role="row">
                                    <span class="crm-table__cell" role="cell" data-label="Client">{{ row.client }}</span>
                                    <span class="crm-table__cell" role="cell" data-label="Tel">{{ row.tel }}</span>
                                    <span class="crm-table__cell" role="cell" data-label="Voyant">{{ row.voyant }}</span>
                                    <span class="crm-table__cell" role="cell" data-label="Consultant">{{ row.consultant }}</span>
                                    <span class="crm-table__cell" role="cell" data-label="Status">{{ row.status }}</span>
                                    <span class="crm-table__cell" role="cell" data-label="Détails">
                                        {% include 'components/ui/info-pill.html.twig' with {
                                            icon: 'eye',
                                            active: row.detailFilled,
                                            active_class: 'is-info-filled',
                                            extra_classes: 'rdv-detail-button rdv-detail-button--icon',
                                            aria_label: 'Voir les détails'
                                        } only %}
                                    </span>
                                </article>
                            {% endfor %}
                        </div>
                    </div>

                    {% include 'components/ui/pagination.html.twig' only %}
                </div>
            </div>
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
