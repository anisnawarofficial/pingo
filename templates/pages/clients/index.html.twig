{% extends 'base.html.twig' %}

{% block title %}Gestion des Clients | Pin’Go CRM{% endblock %}

{% set clients = [
    { id: '#0001', firstName: 'Jhon', lastName: 'Jhonny', birthDate: '01/01/2000', tel: '04 33 22 11 33' },
    { id: '#0002', firstName: 'Jhon', lastName: 'Jhonny', birthDate: '01/01/2000', tel: '04 33 22 11 33' },
    { id: '#0003', firstName: 'Jhon', lastName: 'Jhonny', birthDate: '01/01/2000', tel: '04 33 22 11 33' },
    { id: '#0003', firstName: 'Jhon', lastName: 'Jhonny', birthDate: '01/01/2000', tel: '04 33 22 11 33' }
] %}

{% block body %}
{% embed 'components/dashboard/layout.html.twig' with {
    page_classes: 'rdv-page clients-page',
    main_classes: 'clients-main',
    content_classes: 'dashboard-content--clients',
    active_label: 'Fiche clients'
} %}
    {% block content %}
        {% include 'components/ui/page-header.html.twig' with {
            icon: 'contact-round',
            title: 'Gestion des Clients',
            subtitle: 'Ajouter/Modifier/Chercher des Clients',
            action_label: 'Ajouter un Client',
            action_icon: 'plus',
            extra_classes: 'clients-header',
            left_classes: 'clients-header__title-group',
            icon_classes: 'clients-header__icon',
            action_classes: 'btn-outline-purple clients-add-button'
        } only %}

        {% embed 'components/ui/panel.html.twig' with {
            extra_classes: 'clients-panel clients-search-panel',
            attrs: { 'aria-labelledby': 'client-search-title' },
            use_body: false
        } %}
            {% block content %}
            <h2 id="client-search-title">Formulaire de recherche client</h2>

            <form class="clients-search-form" action="#" method="get">
                <label class="clients-field clients-field--active">
                    <span class="clients-field__label">Prénom du client</span>
                    <input class="crm-input" type="text" name="prenom" value="Eddy" aria-label="Prénom du client">
                </label>

                <label class="clients-field">
                    <span class="clients-field__label">Nom du client</span>
                    <input class="crm-input" type="text" name="nom" placeholder="Nom du client" aria-label="Nom du client">
                </label>

                <label class="clients-field">
                    <span class="clients-field__label">Téléphone du client</span>
                    <input class="crm-input" type="tel" name="telephone" placeholder="Téléphone du client" aria-label="Téléphone du client">
                </label>

                <label class="clients-field clients-field--with-icon">
                    <span class="clients-field__label">Date de naissance</span>
                    <input class="crm-input" type="text" name="date" placeholder="jj/mm/aaaa" aria-label="Date de naissance">
                    <span class="clients-field__icon">
                        {% include 'components/ui/icon.html.twig' with { name: 'calendar-days', size: 'sm' } only %}
                    </span>
                </label>

                <button class="btn btn-primary-gradient clients-search-button" type="submit">
                    {% include 'components/ui/icon.html.twig' with { name: 'search', size: 'sm' } only %}
                    <span>Recherche</span>
                </button>
            </form>
            {% endblock %}
        {% endembed %}

        {% embed 'components/ui/panel.html.twig' with {
            extra_classes: 'clients-panel clients-list-panel',
            attrs: { 'aria-labelledby': 'client-list-title' },
            use_body: false
        } %}
            {% block content %}
            <div class="clients-list-panel__header">
                <h2 id="client-list-title">Rendez-vous du jour</h2>

                <div class="clients-filter-row">
                    <div class="clients-tabs" role="tablist" aria-label="Filtres clients">
                        <button class="clients-tab is-active" type="button" role="tab" aria-selected="true">Titre</button>
                        <button class="clients-tab" type="button" role="tab" aria-selected="false">Titre</button>
                        <button class="clients-tab" type="button" role="tab" aria-selected="false">Titre</button>
                        <button class="clients-tab" type="button" role="tab" aria-selected="false">Titre</button>
                    </div>

                    <div class="clients-date-range" aria-label="Filtre par date">
                        <label class="clients-date-field">
                            <input class="crm-date-input" type="text" value="10-01-2026" aria-label="Date de début">
                            {% include 'components/ui/icon.html.twig' with { name: 'calendar-days', size: 'sm' } only %}
                        </label>
                        <span>jusqu’à</span>
                        <label class="clients-date-field">
                            <input class="crm-date-input" type="text" value="10-01-2026" aria-label="Date de fin">
                            {% include 'components/ui/icon.html.twig' with { name: 'calendar-days', size: 'sm' } only %}
                        </label>
                    </div>
                </div>
            </div>

            <div class="clients-table crm-table crm-table-scroll" role="table" aria-label="Liste des clients" style="--table-columns: 0.62fr 0.76fr 0.82fr 1.28fr 1.18fr 1.02fr 0.74fr 0.36fr;">
                <div class="clients-table__head crm-table__header" role="row">
                    <span class="crm-table__cell" role="columnheader">
                        ID
                        {% include 'components/ui/icon.html.twig' with { name: 'chevron-down', size: 'xs' } only %}
                    </span>
                    <span class="crm-table__cell" role="columnheader">Prénom</span>
                    <span class="crm-table__cell" role="columnheader">Nom</span>
                    <span class="crm-table__cell" role="columnheader">Date de naissance</span>
                    <span class="crm-table__cell" role="columnheader">Tel1</span>
                    <span class="crm-table__cell" role="columnheader">Info</span>
                    <span class="crm-table__cell" role="columnheader">Consult</span>
                    <span class="crm-table__cell" role="columnheader" aria-label="Actions"></span>
                </div>

                <div class="clients-table__body crm-table__body">
                    {% for client in clients %}
                        <article class="clients-table__row crm-table__row" role="row">
                            <span class="crm-table__cell" role="cell" data-label="ID">{{ client.id }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Prénom">{{ client.firstName }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Nom">{{ client.lastName }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Date de naissance">{{ client.birthDate }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Tel1">{{ client.tel }}</span>
                            <span class="crm-table__cell" role="cell" data-label="Info">
                                {% include 'components/ui/info-pill.html.twig' with {
                                    label: 'Visualiser',
                                    icon: 'eye',
                                    extra_classes: 'clients-info-button'
                                } only %}
                            </span>
                            <span class="crm-table__cell" role="cell" data-label="Consult">
                                <button class="btn-circle clients-consult-button" type="button" aria-label="Démarrer une consultation">
                                    {% include 'components/ui/icon.html.twig' with { name: 'headset', size: 'sm' } only %}
                                </button>
                            </span>
                            <span class="crm-table__cell" role="cell" data-label="Actions">
                                <button class="btn-icon clients-row-menu" type="button" aria-label="Actions du client">
                                    {% include 'components/ui/icon.html.twig' with { name: 'more-vertical', size: 'sm' } only %}
                                </button>
                            </span>
                        </article>
                    {% endfor %}
                </div>
            </div>

            {% include 'components/ui/pagination.html.twig' with {
                extra_classes: 'rdv-panel__footer clients-panel__footer'
            } only %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
